#!/bin/bash
# pluginkit mock - behavior controlled by MOCK_PLUGINKIT_MODE
#
# This mock simulates pluginkit behavior for testing RemoveFinderExtension.
# The function calls pluginkit multiple times per invocation:
#   1. pluginkit -m -i <bundle_id>   (presence check — should return info if registered)
#   2. pluginkit -e ignore -i <id>   (disable extension)
#   3. pluginkit -r -i <id>          (remove registration)
#   4. pluginkit -m -i <bundle_id>   (verify-after — should return empty if removed)
#
# Available modes (set via MOCK_PLUGINKIT_MODE):
#   not_found:        -m always returns empty (extension not registered)
#   success:          -m returns info on first call, empty on verify-after; -e and -r succeed
#   still_registered: -m always returns info (extension stays registered after removal)
#   missing:          exit 127 (simulate command not found)
#   fail:             exit 1 (generic failure)
#
# State tracking: uses a temp file to track call count for -m subcommand

MOCK_PLUGINKIT_MODE="${MOCK_PLUGINKIT_MODE:-normal}"

# State file path can be set via MOCK_PLUGINKIT_STATE_FILE to ensure consistency
# across subshell invocations ($(...)) from the same parent function call.
STATE_FILE="${MOCK_PLUGINKIT_STATE_FILE:-/tmp/mock_pluginkit_state}"

# Detect which subcommand is being invoked
subcommand=""
for arg in "$@"; do
    case "$arg" in
        -m) subcommand="match" ;;
        -e) subcommand="election" ;;
        -r) subcommand="remove" ;;
    esac
done

case "$MOCK_PLUGINKIT_MODE" in
    missing)
        exit 127
        ;;

    fail)
        echo "pluginkit: operation failed" >&2
        exit 1
        ;;

    not_found)
        # Extension is never registered — -m returns empty output
        # All other subcommands succeed silently
        exit 0
        ;;

    success)
        # Stateful mock: -m returns info until -r is called, then -m returns empty
        case "$subcommand" in
            match)
                if [[ -f "$STATE_FILE" ]]; then
                    # Extension was removed — return empty (verify-after succeeds)
                    exit 0
                else
                    # Extension is registered
                    echo "    com.vendor.extension(1.0)"
                    exit 0
                fi
                ;;
            election)
                # -e ignore: succeed silently
                exit 0
                ;;
            remove)
                # -r: mark extension as removed
                touch "$STATE_FILE"
                exit 0
                ;;
            *)
                exit 0
                ;;
        esac
        ;;

    still_registered)
        # -m always returns info (extension stays registered even after removal)
        # -e and -r appear to succeed but don't change state
        case "$subcommand" in
            match)
                echo "    com.vendor.extension(1.0)"
                exit 0
                ;;
            *)
                exit 0
                ;;
        esac
        ;;

    *)
        # Normal behavior - delegate to real pluginkit
        /usr/bin/pluginkit "$@"
        ;;
esac
