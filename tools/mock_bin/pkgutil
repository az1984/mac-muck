#!/bin/bash
# pkgutil wrapper - stateful mock with call tracking
#
# This mock simulates pkgutil behavior for testing ForgetPackage.
# Reads MOCK_PKGUTIL_MODE from environment and tracks calls via state file.
#
# State file: /tmp/pkgutil_state
# Format: Line 1 = mode, Line 2 = call count
#
# Behavior modes:
#   - normal:           delegate to real /usr/sbin/pkgutil
#   - missing:          simulate command not found (exit 127)
#   - forget_fail:      --forget fails, --pkg-info succeeds
#   - pkg_info_fail:    --pkg-info always fails (receipt not found)
#   - forget_success:   --pkg-info succeeds, --forget succeeds, then --pkg-info fails
#   - still_present:    --forget succeeds but --pkg-info still succeeds afterward

STATE_FILE="/tmp/pkgutil_state"

# If mode is set in environment, update state file with fresh state
if [[ -n "${MOCK_PKGUTIL_MODE:-}" ]]; then
    printf "%s\n0\n" "${MOCK_PKGUTIL_MODE}" > "$STATE_FILE"
fi

# Read mode from state file (default: normal)
if [[ -f "$STATE_FILE" ]]; then
    MODE=$(head -n1 "$STATE_FILE")
    CALL_COUNT=$(tail -n1 "$STATE_FILE")
    CALL_COUNT=$((CALL_COUNT + 1))
    # Update call count in place
    printf "%s\n%d\n" "$MODE" "$CALL_COUNT" > "$STATE_FILE"
else
    MODE="normal"
    CALL_COUNT=0
fi

case "$MODE" in
    missing)
        exit 127 ;;
    
    forget_fail)
        if [[ "$1" == "--pkg-info" ]]; then
            _pkg_id="$2"
            _pkg_id="${_pkg_id#^}"
            _pkg_id="${_pkg_id%\$}"
            echo "package-id: $_pkg_id"
            echo "version: 1.0.0"
            echo "location: /Applications"
            exit 0
        else
            echo "pkgutil: forget failed" >&2
            exit 1
        fi ;;
    
    pkg_info_fail)
        echo "pkgutil: no package info found" >&2
        exit 1 ;;
    
    pkg_info_ok)
        if [[ "$1" == "--pkg-info" ]]; then
            _pkg_id="$2"
            _pkg_id="${_pkg_id#^}"
            _pkg_id="${_pkg_id%\$}"
            echo "package-id: $_pkg_id"
            echo "version: 1.0.0"
            echo "location: /Applications"
        fi
        exit 0 ;;
    
    forget_success)
        # Call 1-2: --pkg-info succeeds (package exists)
        # Call 2: --forget succeeds  
        # Call 3+: --pkg-info fails (package gone)
        if [[ "$1" == "--pkg-info" ]]; then
            if [[ $CALL_COUNT -le 2 ]]; then
                _pkg_id="$2"
                _pkg_id="${_pkg_id#^}"
                _pkg_id="${_pkg_id%\$}"
                echo "package-id: $_pkg_id"
                echo "version: 1.0.0"
                echo "location: /Applications"
                exit 0
            else
                echo "pkgutil: no package info found" >&2
                exit 1
            fi
        elif [[ "$1" == "--forget" ]]; then
            exit 0
        fi
        exit 0 ;;
    
    still_present)
        # --forget succeeds but --pkg-info still succeeds (receipt persists)
        if [[ "$1" == "--pkg-info" ]]; then
            _pkg_id="$2"
            _pkg_id="${_pkg_id#^}"
            _pkg_id="${_pkg_id%\$}"
            echo "package-id: $_pkg_id"
            echo "version: 1.0.0"
            echo "location: /Applications"
            exit 0
        elif [[ "$1" == "--forget" ]]; then
            exit 0
        fi
        exit 0 ;;
    
    *)
        # Normal behavior - delegate to real pkgutil
        /usr/sbin/pkgutil "$@" ;;
esac